# Backend: SQLite is the zero-dependency local preview database.
APP_ENVIRONMENT=local
DATABASE_URL=sqlite:///./oratry.db
# Replace this with a unique, 32+ character secret outside local development.
JWT_SECRET=change-this-in-production-with-a-32-byte-secret

# Production provider selection. Keep credentials in this untracked .env file.
RECORDING_RETENTION_HOURS=24
OBJECT_STORAGE_PROVIDER=r2
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=oratry-recordings
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
LLM_PROVIDER=openai
OPENAI_API_KEY=
EVALUATOR_MODEL=gpt-5.6-luna
EVALUATOR_REASONING_EFFORT=low
# Gemini is the low-cost V1 evaluator alternative. When LLM_PROVIDER=gemini,
# GEMINI_EVALUATOR_MODEL is used instead of EVALUATOR_MODEL.
GEMINI_API_KEY=
GEMINI_EVALUATOR_MODEL=gemini-3.5-flash-lite

# Durable analysis worker lifecycle and configuration-versioned accounting.
# Leave unit-price values blank to retain actual usage without estimates.
ANALYSIS_JOB_LEASE_SECONDS=120
ANALYSIS_LLM_TIMEOUT_SECONDS=60
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_COST_VERSION=unconfigured
STT_COST_USD_PER_AUDIO_MINUTE=
LLM_INPUT_COST_USD_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_USD_PER_MILLION_TOKENS=

# Email activation. Development uses a volatile local outbox; production uses
# Resend and must provide both values. Never commit the API key.
EMAIL_PROVIDER=development_outbox
ACTIVATION_URL_BASE=http://127.0.0.1:3000/activate
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Google OpenID Connect. Create a Web application OAuth client and register
# the exact callback below with Google. The client secret stays server-side.
WEB_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/v1/auth/google/callback
OAUTH_HANDOFF_MINUTES=5

# Shared English lexical-reference cache. The default tries dictionaryapi.dev
# first and falls back to Datamuse only for primary access failures. Set to
# disabled to retain manually entered vocabulary without external lookup.
DICTIONARY_PROVIDER=free_dictionary_api
DICTIONARY_CACHE_HOURS=168

# Leave unset for the browser preview: the UI uses its built-in mock provider.
# To point a future authenticated browser client at FastAPI, use:
# NEXT_PUBLIC_API_URL=http://localhost:8000/v1
